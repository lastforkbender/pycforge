{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pycforge.decision-trace/0.12",
  "type": "object",
  "required": [
    "schema_version",
    "converter_version",
    "trace_level",
    "input_fingerprint",
    "configuration_fingerprint",
    "resource_policy_fingerprint",
    "stage_summaries",
    "rule_decisions",
    "diagnostics",
    "output_fingerprint",
    "source_output_mappings",
    "generated_artifact",
    "target_contract",
    "semantic_policy",
    "approximation_allowlist",
    "rule_set_version",
    "renderer_version",
    "helper_policy_version",
    "container_policy_version",
    "module_policy_version",
    "rule_manifest_fingerprint",
    "helper_registry_fingerprint",
    "helper_manifest",
    "helper_manifest_fingerprint",
    "module_manifest",
    "module_imports",
    "module_initialization",
    "completeness",
    "events",
    "truncated",
    "observer_failed",
    "trace_fingerprint"
  ],
  "properties": {
    "schema_version": {"const": "pycforge.decision-trace/0.12"},
    "converter_version": {"type": "string"},
    "trace_level": {"enum": ["None", "Summary", "Decisions", "Full"]},
    "input_fingerprint": {"type": "string"},
    "configuration_fingerprint": {"type": "string"},
    "resource_policy_fingerprint": {"type": "string"},
    "stage_summaries": {"type": "array", "items": {"type": "object"}},
    "rule_decisions": {"type": "array", "items": {"type": "object"}},
    "diagnostics": {"type": "array", "items": {"type": "object"}},
    "output_fingerprint": {"type": ["string", "null"]},
    "source_output_mappings": {"type": "array", "items": {"type": "object"}},
    "generated_artifact": {
      "type": "object",
      "required": ["kind", "schema_version", "artifact_fingerprint", "parent_fingerprint"],
      "properties": {
        "kind": {"type": "string"},
        "schema_version": {"type": "string"},
        "artifact_fingerprint": {"type": "string"},
        "parent_fingerprint": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "target_contract": {"type": "string"},
    "semantic_policy": {"type": "string"},
    "approximation_allowlist": {"type": "array", "items": {"type": "string"}},
    "rule_set_version": {"type": "string"},
    "renderer_version": {"type": "string"},
    "helper_policy_version": {"type": "string"},
    "container_policy_version": {"type": "string"},
    "module_policy_version": {"type": "string"},
    "rule_manifest_fingerprint": {"type": "string"},
    "helper_registry_fingerprint": {"type": ["string", "null"]},
    "helper_manifest": {"type": "array", "items": {"type": "object"}},
    "helper_manifest_fingerprint": {"type": "string"},
    "module_manifest": {"type": "array", "items": {"type": "object"}},
    "module_imports": {"type": "array", "items": {"type": "object"}},
    "module_initialization": {"type": ["object", "null"]},
    "completeness": {"enum": ["complete", "deterministically-truncated", "observer-failed"]},
    "events": {"type": "array", "items": {"type": "object"}},
    "truncated": {"type": "boolean"},
    "observer_failed": {"type": "boolean"},
    "trace_fingerprint": {"type": "string"}
  },
  "additionalProperties": false,
  "description": "Deterministic, immutable conversion-decision record. Operational measurements are excluded."
}
